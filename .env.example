PANEL_HOST=0.0.0.0
PANEL_PORT=3210
PZ_CONFIG_DIR=/home/steam/Zomboid/Server
PZ_SERVER_DIR=/home/steam/pz_server
PZ_STEAMCMD_PATH=/usr/games/steamcmd
PZ_SERVER_NAME=servertest
PZ_PANEL_BACKUP_DIR=/home/steam/Zomboid/Server/.pz-config-panel-backups
PZ_SYSTEMD_UNIT=project-zomboid.service
# Optional until Live RCON is used. Keep host local and match the game server RCON values.
PZ_RCON_HOST=127.0.0.1
PZ_RCON_PORT=27015
PZ_RCON_PASSWORD=<match_server_ini_rcon_password>
PZ_RCON_TIMEOUT_MS=5000
PANEL_USERNAME=your_username
# Required: the panel refuses to start without a password.
PANEL_PASSWORD=<changeme>
# Optional: Bearer token session lifetime in hours. Defaults to 8.
SESSION_TTL_HOURS=8
